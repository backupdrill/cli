{
  "name": "backupdrill",
  "version": "2.11.0",
  "description": "Open-source CLI to back up a Supabase project to your own S3/R2/B2 bucket (the Postgres database, Auth users when your role can read them, and Storage files once you add the project's Storage S3 keys), then run a restore drill that proves the backup restores.",
  "type": "module",
  "bin": {
    "backupdrill": "dist/index.js"
  },
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "plugin/skills",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "skills": [
      "./plugin/skills"
    ]
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "dev": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "supabase",
    "supabase-backup",
    "backup",
    "database-backup",
    "postgres",
    "postgresql",
    "pg_dump",
    "restore",
    "s3",
    "cloudflare-r2",
    "backblaze-b2",
    "disaster-recovery",
    "supabase-auth",
    "backup-verification",
    "healthchecks",
    "pi-package"
  ],
  "license": "MIT",
  "author": "BackupDrill <support@backupdrill.com> (https://backupdrill.com)",
  "homepage": "https://backupdrill.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backupdrill/cli.git"
  },
  "bugs": {
    "url": "https://github.com/backupdrill/cli/issues"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/lib-storage": "^3.658.0",
    "commander": "^12.1.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0"
  }
}
